+#ifdef CONFIG_VIDEO_INTEL_IPU4P
+int ipu_isys_csi2_rearm_receiver(struct ipu_isys_csi2 *csi2)
+{
+	struct ipu_isys_csi2_timing timing;
+	int rval;
+
+	/* Preserve the stream-count ownership of the normal graph teardown. */
+	if (csi2->stream_count != 1 || !csi2->nlanes)
+		return -EBUSY;
+
+	/* Fail before touching hardware if the current link cannot be timed. */
+	rval = ipu_isys_csi2_calc_timing(csi2, &timing, CSI2_ACCINV);
+	if (rval)
+		return rval;
+
+	rval = ipu_isys_csi2_set_stream(&csi2->asd.sd, timing, 0, 0);
+	if (rval)
+		return rval;
+
+	rval = ipu_isys_csi2_set_stream(&csi2->asd.sd, timing,
+					csi2->nlanes, 1);
+	if (!rval)
+		dev_dbg(&csi2->isys->adev->dev,
+			"csi2-%u: receiver rearmed between sensor retries, nlanes=%u\n",
+			csi2->index, csi2->nlanes);
+
+	return rval;
+}
+#endif
