+/*
+ * A skipped video pin returns ownership without valid image data. Match both
+ * firmware identity fields before detaching a buffer. Do not route this through
+ * pin_ready: a zero firmware error is still a cancellation, and its timestamp
+ * is not a captured-frame timestamp.
+ *
+ * This handles progressive video queues. Interlaced/short-packet/ISA terminal
+ * cancellation needs separate callbacks and remains fail-closed.
+ */
+int ipu_isys_queue_buf_skipped(struct ipu_isys_pipeline *ip,
+			       struct ipu_fw_isys_resp_info_abi *info)
+{
+	struct device *dev = &ip->isys->adev->dev;
+	struct ipu_isys_queue *aq;
+	struct ipu_isys_buffer *ib, *found = NULL;
+	struct vb2_buffer *vb;
+	struct vb2_v4l2_buffer *vbuf;
+	unsigned long flags;
+	unsigned int plane;
+	bool parked;
+
+	/* A cancellation cannot make a partly delivered verification round clean. */
+	if (atomic_read(&ip->verify_active) &&
+	    (!info->error_info.error || info->error_info.error ==
+	     IPU_FW_ISYS_ERROR_STREAM_IN_SUSPENSION))
+		atomic_inc(&ip->verify_errors);
+
+	if (info->stream_handle != ip->stream_handle || ip->interlaced ||
+	    ip->isl_mode != IPU_ISL_OFF ||
+	    info->pin_id >= ip->nr_output_pins ||
+	    info->pin_id >= IPU_ISYS_OUTPUT_PINS ||
+	    !info->pin.addr || !info->pin.out_buf_id) {
+		dev_err(dev, "invalid/unsupported skipped video pin %u\n",
+			info->pin_id);
+		return -EINVAL;
+	}
+	aq = ip->output_pins[info->pin_id].aq;
+	if (!aq) {
+		dev_err(dev, "skipped pin %u has no video queue\n", info->pin_id);
+		return -EOPNOTSUPP;
+	}
+
+	spin_lock_irqsave(&aq->lock, flags);
+	list_for_each_entry(ib, &aq->active, head) {
+		vb = ipu_isys_buffer_to_vb2_buffer(ib);
+		if (info->pin.out_buf_id != (u64)vb->index + 1 ||
+		    info->pin.addr != vb2_dma_contig_plane_dma_addr(vb, 0))
+			continue;
+		if (found) {
+			spin_unlock_irqrestore(&aq->lock, flags);
+			dev_err(dev, "ambiguous skipped video buffer identity\n");
+			return -EINVAL;
+		}
+		found = ib;
+	}
+	if (!found) {
+		spin_unlock_irqrestore(&aq->lock, flags);
+		dev_err(dev, "skipped video buffer is not owned by the active queue\n");
+		return -ENOENT;
+	}
+	vb = ipu_isys_buffer_to_vb2_buffer(found);
+	if (vb->state != VB2_BUF_STATE_ACTIVE) {
+		spin_unlock_irqrestore(&aq->lock, flags);
+		dev_err(dev, "skipped video buffer is not VB2 active\n");
+		return -EINVAL;
+	}
+	vbuf = to_vb2_v4l2_buffer(vb);
+	vbuf->field = V4L2_FIELD_NONE;
+	vbuf->sequence = 0;
+	vb->timestamp = 0;
+	for (plane = 0; plane < vb->num_planes; plane++)
+		vb2_set_plane_payload(vb, plane, 0);
+	atomic_set(&found->str2mmio_flag, 0);
+
+	parked = atomic_read(&ip->verify_active) && !found->req;
+	if (parked)
+		list_move(&found->head, &aq->incoming);
+	else
+		list_del_init(&found->head);
+	spin_unlock_irqrestore(&aq->lock, flags);
+
+	dev_dbg(dev,
+		"skipped video buffer: stream=%u pin=%u id=%llu addr=0x%08x index=%u parked=%u raw_timestamp=0x%016llx\n",
+		info->stream_handle, info->pin_id,
+		(unsigned long long)info->pin.out_buf_id, info->pin.addr,
+		vb->index, parked,
+		(unsigned long long)info->timestamp[1] << 32 | info->timestamp[0]);
+	if (!parked)
+		vb2_buffer_done(vb, VB2_BUF_STATE_ERROR);
+	return 0;
+}
