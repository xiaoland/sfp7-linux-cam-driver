+MODULE_PARM_DESC(phy_bb_extra,
+		 "Extra PHY building blocks to configure (-1 = none)");
+
+static int phy_afe_extra[8] = { -1, -1, -1, -1, -1, -1, -1, -1 };
+module_param_array(phy_afe_extra, int, NULL, 0644);
+MODULE_PARM_DESC(phy_afe_extra,
