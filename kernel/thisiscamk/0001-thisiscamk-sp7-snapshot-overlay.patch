+static void ipu4p_isys_bb_cfg_one(struct ipu_isys *isys, unsigned int bb,
+				  unsigned int crc, unsigned int drc,
+				  unsigned int afe)
+{
+	void __iomem *isp_base = isys->adev->isp->base;
+	u32 val;
