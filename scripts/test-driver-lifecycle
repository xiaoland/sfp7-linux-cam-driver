#!/usr/bin/env python3
"""运行实际驱动函数的失败路径；依赖用受控桩替代，不执行硬件或模拟完整内核。"""
# ponytail: 主机桩不覆盖 IRQ/PM 交错；目标内核可用后以受控故障注入补验。

import argparse
import os
from pathlib import Path
import re
import shlex
import subprocess
import tempfile


SUITES = {
    "firmware-lifecycle": ("ipu-isys-video.c", [
        "fill_stream_input_config", "get_stream_opened", "put_stream_opened", "get_stream_handle",
        "put_stream_handle", "close_streaming_firmware", "start_stream_firmware",
        "stop_streaming_firmware", "ipu_isys_video_set_streaming",
    ]),
    "stream-start": ("ipu-isys-queue.c", [
        "stream_capture_refeed", "ipu_isys_stream_start",
    ]),
    "verification-handoff": ("ipu-isys-queue.c", ["verify_stream_start"]),
}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path, help="叠加补丁后的 Linux 源树")
    parser.add_argument("--suite", choices=SUITES, help="默认运行全部组")
    args = parser.parse_args()
    tests = Path(__file__).resolve().parents[1] / "tests/driver"
    failures = 0
    with tempfile.TemporaryDirectory(prefix="sfp7-lifecycle-test-") as temporary:
        scratch = Path(temporary)
        for suite in [args.suite] if args.suite else SUITES:
            source, functions = SUITES[suite]
            text = (args.source / "drivers/media/pci/intel" / source).read_text()
            bodies = re.findall(r"(?m)^#define IPU_ISYS_VERIFY_[^\n]+", text)
            for function in functions:
                # 只接受本驱动已有的顶层函数格式，不把声明或手写模型当作被测实现。
                match = re.search(
                    rf"(?m)^(?:static\s+)?(?:int|void|bool)\s+{function}\([^;{{]*\)\n\{{",
                    text,
                )
                if match is None:
                    raise ValueError(f"没有找到函数定义: {source}:{function}")
                end = text.index("\n}\n", match.end()) + 3
                bodies.append(text[match.start():end])
            (scratch / "lifecycle-under-test.c").write_text("\n".join(bodies))
            binary = scratch / suite
            subprocess.run([
                *shlex.split(os.environ.get("CC", "cc")), "-std=c11", "-Wall",
                "-Wextra", "-Werror", "-Wno-unused-parameter", "-I", str(scratch),
                str(tests / f"{suite}.c"), "-o", str(binary),
            ], check=True)
            failures += subprocess.run([str(binary)]).returncode != 0
    raise SystemExit(bool(failures))


if __name__ == "__main__":
    main()
