#!/usr/bin/env python3
"""编译并运行实际 __buf_queue；仅模拟其依赖，不模拟硬件或内核并发。"""

import argparse
import os
from pathlib import Path
import shlex
import subprocess
import tempfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path, help="叠加补丁后的 Linux 源树")
    args = parser.parse_args()
    source = args.source / "drivers/media/pci/intel/ipu-isys-queue.c"
    text = source.read_text(encoding="utf-8")
    start = text.index("static void __buf_queue(")
    end = text.index("\n}\n", start) + 3
    harness = Path(__file__).resolve().parents[1] / "tests/driver/queue-ownership.c"
    with tempfile.TemporaryDirectory(prefix="sfp7-queue-test-") as temporary:
        scratch = Path(temporary)
        (scratch / "queue-under-test.c").write_text(text[start:end], encoding="utf-8")
        binary = scratch / "queue-test"
        subprocess.run([
            *shlex.split(os.environ.get("CC", "cc")), "-std=c11", "-Wall",
            "-Wextra", "-Werror", "-Wno-unused-parameter", "-I", str(scratch),
            str(harness), "-o", str(binary),
        ], check=True)
        subprocess.run([str(binary)], check=True)


if __name__ == "__main__":
    main()
