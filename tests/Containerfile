# Build-only environment; no camera devices or host files are mounted.
FROM fedora:42@sha256:99e203b80b1c3d8f7e161ec10a68fd02b081ef83a3963553e513c82846b97814
RUN dnf -y install gcc-c++ git meson ninja-build python3-jinja2 python3-ply \
    python3-pyyaml libyaml-devel openssl-devel systemd-devel libevent-devel \
    libdrm-devel libjpeg-turbo-devel libyuv-devel libatomic libasan libubsan \
    pkgconf-pkg-config diffutils && dnf clean all
WORKDIR /work
