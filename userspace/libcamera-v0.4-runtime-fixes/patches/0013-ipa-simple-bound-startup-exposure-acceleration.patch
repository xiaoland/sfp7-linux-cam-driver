Subject: [PATCH] ipa: simple: bound dark startup exposure acceleration

Try 20% requested exposure or gain steps only during dark startup. Return
to the original 10% feedback on the first MSV above 1.5, or after 96 valid
statistics callbacks. Never accelerate both exposure and gain together.
Empty statistics do not advance controls or consume the startup budget.

This is a bounded experimental startup policy; the callback budget is not
a sensor-frame or elapsed-time guarantee. Hardware comparison is pending.

---
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -7,6 +7,8 @@
 
 #include "agc.h"
 
+#include <algorithm>
+#include <cmath>
 #include <stdint.h>
 
 #include <libcamera/base/log.h>
@@ -39,8 +41,69 @@
 {
 }
 
+int Agc::configure([[maybe_unused]] IPAContext &context,
+		   [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	startup_ = true;
+	startupComputations_ = 0;
+	return 0;
+}
+
 void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, double exposureMSV)
 {
+	/* Invalid/empty statistics do not consume the valid-computation budget. */
+	if (!std::isfinite(exposureMSV) || exposureMSV <= 0)
+		return;
+
+	bool tryStartup = false;
+	if (startup_) {
+		++startupComputations_;
+		tryStartup = exposureMSV <= 1.5;
+		/* This counts valid callbacks, not sensor control generations. */
+		if (!tryStartup || startupComputations_ >= 96)
+			startup_ = false;
+	}
+
+	if (tryStartup) {
+		int32_t &exposure = frameContext.sensor.exposure;
+		double &again = frameContext.sensor.gain;
+		bool boosted = false;
+
+		/* Only one actuator is increased in an accelerated update. */
+		if (exposure < context.configuration.agc.exposureMax) {
+			int32_t next = std::min<int64_t>(
+				context.configuration.agc.exposureMax,
+				static_cast<int64_t>(exposure) * 6 / 5);
+			if (next > exposure) {
+				exposure = next;
+				boosted = true;
+			}
+		} else {
+			double next = std::min(context.configuration.agc.againMax,
+					       again * 1.2);
+			if (next > again &&
+			    (next - again >= context.configuration.agc.againMinStep ||
+			     next == context.configuration.agc.againMax)) {
+				again = next;
+				boosted = true;
+			}
+		}
+
+		if (exposure == context.configuration.agc.exposureMax &&
+		    again == context.configuration.agc.againMax)
+			startup_ = false;
+
+		if (boosted) {
+			LOG(IPASoftExposure, Debug)
+				<< "exposureMSV " << exposureMSV
+				<< " exp " << exposure << " again " << again
+				<< " startupBoost 1 validComputations "
+				<< startupComputations_;
+			return;
+		}
+		/* Keep the original minimum-step rule if a 20% step is too small. */
+	}
+
 	/*
 	 * kExpDenominator of 10 gives ~10% increment/decrement;
 	 * kExpDenominator of 5 - about ~20%
--- a/src/ipa/simple/algorithms/agc.h
+++ b/src/ipa/simple/algorithms/agc.h
@@ -19,12 +19,17 @@
 	Agc();
 	~Agc() = default;
 
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+
 	void process(IPAContext &context, const uint32_t frame,
 		     IPAFrameContext &frameContext,
 		     const SwIspStats *stats,
 		     ControlList &metadata) override;
 
 private:
+	bool startup_ = true;
+	unsigned int startupComputations_ = 0;
+
 	void updateExposure(IPAContext &context, IPAFrameContext &frameContext, double exposureMSV);
 };
 
