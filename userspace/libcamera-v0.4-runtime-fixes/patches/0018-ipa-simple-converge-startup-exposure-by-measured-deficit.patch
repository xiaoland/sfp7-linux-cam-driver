Subject: [PATCH] ipa: simple: converge startup exposure by measured deficit

The fixed 20% dark-start step can require seven effective sensor-control
generations to move the rear sensor from a cached 632-line exposure to its
2462-line limit.  Its three-frame control delay repeats each request, making
the visible ramp take several seconds.

During the already bounded startup phase, scale the active exposure actuator
by the target-to-measured MSV ratio, capped at 2x, until the normal controller's
satisfactory band is reached.  Preserve the single-actuator rule, valid
callback budget, saturation exit and original steady-state controller.

---
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -58,7 +58,7 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, dou
 	bool tryStartup = false;
 	if (startup_) {
 		++startupComputations_;
-		tryStartup = exposureMSV <= 1.5;
+		tryStartup = exposureMSV < kExposureOptimal - kExposureSatisfactory;
 		/* This counts valid callbacks, not sensor control generations. */
 		if (!tryStartup || startupComputations_ >= 96)
 			startup_ = false;
@@ -68,19 +68,24 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, dou
 		int32_t &exposure = frameContext.sensor.exposure;
 		double &again = frameContext.sensor.gain;
 		bool boosted = false;
+		double factor = std::clamp(kExposureOptimal / exposureMSV,
+					   1.0, 2.0);
 
-		/* Only one actuator is increased in an accelerated update. */
+		/*
+		 * Correct by the measured deficit while bounding each request to 2x.
+		 * Only one actuator is increased in an accelerated update.
+		 */
 		if (exposure < context.configuration.agc.exposureMax) {
 			int32_t next = std::min<int64_t>(
 				context.configuration.agc.exposureMax,
-				static_cast<int64_t>(exposure) * 6 / 5);
+				static_cast<int64_t>(exposure * factor));
 			if (next > exposure) {
 				exposure = next;
 				boosted = true;
 			}
 		} else {
 			double next = std::min(context.configuration.agc.againMax,
-					       again * 1.2);
+					       again * factor);
 			if (next > again &&
 			    (next - again >= context.configuration.agc.againMinStep ||
 			     next == context.configuration.agc.againMax)) {
