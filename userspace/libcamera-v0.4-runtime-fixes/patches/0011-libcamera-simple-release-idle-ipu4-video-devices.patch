+
+void SimplePipelineHandler::closeIdleVideos()
+{
+	if (!releaseIdleVideo_)
+		return;
+
+	for (auto &[entity, data] : entities_) {
+		if (data.video && data.owners.empty())
+			data.video->close();
+	}
+}
+
+int SimplePipelineHandler::openVideo(SimpleCameraData *data)
+{
+	EntityData &entity = entities_.at(data->entities_.back().entity);
+	if (entity.videoFailed)
+		return -EIO;
+	if (data->video_->isOpen())
+		return 0;
+
+	int ret = data->video_->open();
+	if (ret < 0)
+		data->video_->close();
+	return ret;
+}
+
+int SimplePipelineHandler::restoreCapture(SimpleCameraData *data)
+{
+	if (!data->captureFormatValid_)
+		return -EINVAL;
+
+	int ret = data->setupLinks();
+	if (ret < 0)
+		return ret;
+
+	V4L2SubdeviceFormat pipelineFormat = data->pipelineFormat_;
+	ret = data->setupFormats(&pipelineFormat, V4L2Subdevice::ActiveFormat,
+				 data->pipelineTransform_);
+	if (ret < 0)
+		return ret;
+
+	const V4L2DeviceFormat &expected = data->captureFormat_;
+	V4L2DeviceFormat actual = expected;
+	ret = data->video_->setFormat(&actual);
+	if (ret < 0)
+		return ret;
+	if (actual.fourcc != expected.fourcc || actual.size != expected.size ||
+	    actual.colorSpace != expected.colorSpace ||
+	    actual.planesCount != expected.planesCount)
+		return -EINVAL;
+	for (unsigned int i = 0; i < actual.planesCount; ++i) {
+		if (actual.planes[i].bpl != expected.planes[i].bpl ||
+		    actual.planes[i].size != expected.planes[i].size)
+			return -EINVAL;
+	}
+	return 0;
 }
 
