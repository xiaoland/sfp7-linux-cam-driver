#!/usr/bin/env bash
# Load the Surface Pro 7 IPU4P stack once, in dependency/power-safe order.

set -euo pipefail

readonly EXPECTED_RELEASE="6.19.8-sfp7cam.p1.fc42.x86_64"
readonly FIRMWARE="/usr/lib/firmware/ipu4p_cpd.bin"
readonly FIRMWARE_SHA256="ff2c36cc81a5c726508b22970c2e2538ff06107dc5a72c93401403c227e5157f"
readonly MMU1_POWER_CONTROL="/sys/bus/intel-ipu4-bus/devices/intel-ipu4-mmu1/power/control"
readonly VCM_DEVICE="/sys/bus/i2c/devices/i2c-INT347A:00-VCM"
readonly EXPECTED_MODULE_SIGNER="Build time autogenerated kernel key"
readonly MODULE_DIRECTORY="/lib/modules/$EXPECTED_RELEASE"
# Keep each module, relative path and expected digest in one reviewable record.
readonly -a IPU_MODULE_IDENTITIES=(
  "dw9719|kernel/drivers/media/i2c/dw9719.ko|5b52f6522bacafba7a470aaee58718e88c4c49d9dfd18b94e921f3dda6722630"
  "ipu_bridge|kernel/drivers/media/pci/intel/ipu-bridge.ko|103ef90ec067186ca3ae664cc7cc9f86b9a28fb122273080beae360760d67324"
  "intel_ipu4p_isys_csslib|kernel/drivers/media/pci/intel/ipu4/intel-ipu4p-isys-csslib.ko|913bc61bfbbd2514e66f3a9691c20cd913a9f1c55befe9b90cd3b9cd0da61c54"
  "intel_ipu4p_psys_csslib|kernel/drivers/media/pci/intel/ipu4/ipu4p-css/lib2600psys/intel-ipu4p-psys-csslib.ko|b032af8020c4bb09f45f5dff03fbf49edf9d23b9dc877fe5641c84fa5ad32109"
  "intel_ipu4p|kernel/drivers/media/pci/intel/ipu4/intel-ipu4p.ko|b4f5efed281755b1fa9c61ad2c5ef9c07198edd22bb7a8f332037be616eabbf9"
  "intel_ipu4p_psys|kernel/drivers/media/pci/intel/ipu4/intel-ipu4p-psys.ko|3a30754525bccef695bdc71ad49e471662262774b0a3c0afd8c21da402240e44"
  "intel_ipu4p_isys|kernel/drivers/media/pci/intel/ipu4/intel-ipu4p-isys.ko|b36b711142759a962449e6637c4e97519f66c55d861f68b35d01519cd364a2ce"
)

if (( EUID != 0 )); then
  echo "sfp7-camera-load must run as root" >&2
  exit 2
fi

running_release="$(uname -r)"
if [[ "$running_release" != "$EXPECTED_RELEASE" ]]; then
  echo "refusing to load IPU4P on unexpected kernel: $running_release" >&2
  exit 2
fi

if [[ ! -f "$FIRMWARE" || -L "$FIRMWARE" ]]; then
  echo "missing firmware: $FIRMWARE" >&2
  exit 2
fi

firmware_sha256="$(sha256sum "$FIRMWARE" | awk '{print $1}')"
if [[ "$firmware_sha256" != "$FIRMWARE_SHA256" ]]; then
  echo "unexpected firmware digest: $firmware_sha256" >&2
  exit 2
fi

for identity in "${IPU_MODULE_IDENTITIES[@]}"; do
  IFS='|' read -r module relative_path expected_sha256 <<< "$identity"
  if [[ -z "$module" || "$relative_path" != kernel/* \
      || ! "$expected_sha256" =~ ^[[:xdigit:]]{64}$ ]]; then
    echo "internal module identity table mismatch" >&2
    exit 2
  fi
  expected_path="$MODULE_DIRECTORY/$relative_path"
  actual_path="$(modinfo -n "$module")"
  if [[ "$actual_path" != "$expected_path" || ! -f "$actual_path" \
      || -L "$actual_path" ]]; then
    echo "unexpected module path: $module -> $actual_path" >&2
    exit 2
  fi
  actual_sha256="$(sha256sum "$actual_path" | awk '{print $1}')"
  if [[ "$actual_sha256" != "$expected_sha256" ]]; then
    echo "unexpected module digest: $module -> $actual_sha256" >&2
    exit 2
  fi
  module_release="$(modinfo -F vermagic "$module" | awk '{print $1}')"
  module_signer="$(modinfo -F signer "$module")"
  if [[ "$module_release" != "$EXPECTED_RELEASE" \
      || "$module_signer" != "$EXPECTED_MODULE_SIGNER" ]]; then
    echo "unexpected module signature identity: $module" >&2
    exit 2
  fi
done

for identity in "${IPU_MODULE_IDENTITIES[@]}"; do
  module="${identity%%|*}"
  if [[ -d "/sys/module/$module" ]]; then
    echo "refusing a second load in this boot; module already present: $module" >&2
    exit 2
  fi
done

boot_id="$(< /proc/sys/kernel/random/boot_id)"
attempt_marker="/run/sfp7-camera-load-$boot_id"
if ! mkdir -m 0755 "$attempt_marker"; then
  echo "refusing a second IPU4P load attempt in boot $boot_id" >&2
  exit 2
fi

started_at="$(date --iso-8601=seconds)"
failed_module="none"

report_failure() {
  status=$?
  echo "IPU4P load failed at module/state: $failed_module" >&2
  echo "Do not unload/reload this stack; reboot before retrying." >&2
  journalctl -k --since "$started_at" --no-pager >&2 || true
  exit "$status"
}
trap report_failure ERR

release_mmu1_load_pin() {
  local before="$attempt_marker/mmu1-power-control.before-release.txt"
  local after="$attempt_marker/mmu1-power-control.after-release.txt"

  failed_module="mmu1-load-settle"
  cat "$MMU1_POWER_CONTROL" >"$before" || return $?
  [[ $(< "$before") == on ]] || return 1
  # Keep the load-time udev probe storm covered. Time alone is not a quiet gate.
  sleep 30 || return $?
  udevadm settle --timeout=10 || return $?

  failed_module="mmu1-release"
  printf 'auto\n' >"$MMU1_POWER_CONTROL" || return $?
  cat "$MMU1_POWER_CONTROL" >"$after" || return $?
  [[ $(< "$after") == auto ]]
}

failed_module="dw9719"
modprobe dw9719
failed_module="ipu_bridge"
modprobe ipu_bridge
failed_module="intel_ipu4p_isys_csslib"
modprobe intel_ipu4p_isys_csslib
failed_module="intel_ipu4p_psys_csslib"
modprobe intel_ipu4p_psys_csslib
failed_module="intel_ipu4p"
modprobe intel_ipu4p
failed_module="intel_ipu4p_psys"
modprobe intel_ipu4p_psys

failed_module="mmu1-power-control"
for _ in $(seq 1 50); do
  [[ -e "$MMU1_POWER_CONTROL" ]] && break
  sleep 0.1
done
[[ -e "$MMU1_POWER_CONTROL" ]]
printf 'on\n' >"$MMU1_POWER_CONTROL"

failed_module="intel_ipu4p_isys"
modprobe intel_ipu4p_isys

failed_module="device-discovery"
for _ in $(seq 1 100); do
  [[ -e /dev/media0 ]] && break
  sleep 0.1
done
[[ -e /dev/media0 ]]

failed_module="dw9719-binding"
for _ in $(seq 1 100); do
  [[ -L "$VCM_DEVICE/driver" ]] && break
  sleep 0.1
done
[[ -L "$VCM_DEVICE/driver" ]]
[[ $(readlink -f "$VCM_DEVICE/driver") == /sys/bus/i2c/drivers/dw9719 ]]

release_mmu1_load_pin || report_failure

trap - ERR
printf 'IPU4P stack loaded on %s\n' "$running_release"
find /dev -maxdepth 1 \
  \( -name 'media*' -o -name 'video*' -o -name 'v4l-subdev*' -o -name 'ipu-psys*' \) \
  -printf '%f\n' | sort
journalctl -k --since "$started_at" --no-pager \
  | grep -Ei 'ipu|cse|firmware|camera|ov5693|ov8865|ov7251|dw9719' \
  | tail -n 160 || true
